# Copia a .env.local (nunca lo commitees)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional: remitente verificado en Resend (por defecto, el de pruebas)
CONTACT_FROM_EMAIL=
# Opcional: simula el proveedor sin enviar: mock | mock-fail
CONTACT_TRANSPORT=
# URL pública del sitio (canonical, hreflang, sitemap, Open Graph). Sin barra final.
SITE_URL=
