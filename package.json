{
  "name": "compile-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "COMPILE — portafolio-odisea: el viaje de una línea de código.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "6.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.6.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "resend": "6.34.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:contrast": "tsx scripts/check-contrast.ts",
    "content:check": "tsx scripts/content-check.ts",
    "content:todo": "tsx scripts/content-todo.ts",
    "fonts:sync": "tsx scripts/sync-fonts.ts",
    "prebuild": "pnpm content:check && pnpm tokens:contrast"
  }
}
